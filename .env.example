# =============================================================================
# GDD Review 环境变量配置模板
# =============================================================================
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 在 .env 中填入你真实的 url 与 key(该文件已被 gitignore,不会入库)
#
# 配置分两组,互相独立,可以用不同供应商:
#   ── Agent 模型(评审/蒸馏的 LLM) ──
#   ── Embedding 模型(wiki 语义检索的向量化) ──
# 两组都要求 OpenAI 兼容协议(/v1/embeddings 与 /v1/chat/completions)。
# =============================================================================


# ── Agent 模型配置(必填) ─────────────────────────────────────────────────────
# 评审与蒸馏所用 LLM 的 API Key
OPENAI_API_KEY=

# Agent 模型的 OpenAI 兼容端点(不含末尾斜杠)
# 示例格式: https://你的供应商域名/兼容路径/v1
OPENAI_BASE_URL=

# Agent 模型名(区分大小写,以供应商控制台为准)
OPENAI_MODEL=


# ── Embedding 模型配置(使用语义检索时必填) ───────────────────────────────────
# 独立配置: 语义检索(embed 命令与 wiki_search)用,可与 Agent 模型不同供应商
# 若整组留空,框架自动降级为关键词检索,功能不受影响
#
# Embedding 的 API Key
EMBEDDING_API_KEY=

# Embedding 的 OpenAI 兼容端点(不含末尾斜杠)
# 示例格式: https://你的供应商域名/兼容路径/v1
EMBEDDING_BASE_URL=

# Embedding 模型名(以供应商控制台为准)
EMBEDDING_MODEL=
